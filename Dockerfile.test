FROM ros:humble

# Install dependencies
RUN apt-get update && apt-get install -y \
    python3-pip \
    python3-pytest \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip3 install \
    numpy \
    requests

# Install ROS 2 dependencies
RUN apt-get update && apt-get install -y \
    ros-humble-control-msgs \
    && rm -rf /var/lib/apt/lists/*

# Set up workspace
WORKDIR /ros_ws

# Copy workspace
COPY ros_ws /ros_ws

# Build the workspace from the workspace root
WORKDIR /ros_ws
RUN . /opt/ros/humble/setup.sh && colcon build && ls -l /ros_ws/install && ls -l /ros_ws/build

# Copy test entrypoint
COPY ros_ws/test_entrypoint.sh /test_entrypoint.sh
RUN chmod +x /test_entrypoint.sh

ENTRYPOINT ["/test_entrypoint.sh"] 